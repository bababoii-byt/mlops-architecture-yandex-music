@startuml
!include <C4/C4_Context>

title C4 — Контекст системы формирования семейного плейлиста

Person(user, "Участник семейной подписки", "Получает семейный плейлист, слушает треки и взаимодействует с ними")

System(playlist, "Система формирования семейного плейлиста", "Еженедельно подбирает и публикует персонализированный плейлист для семьи")

System_Ext(app, "Приложение Яндекс Музыки", "Интерфейс для прослушивания плейлиста")
System_Ext(family, "Сервис семейных подписок", "Хранит состав семьи и настройки участия")
System_Ext(history, "Сервис истории прослушиваний", "Предоставляет историю и пользовательские реакции на треки")
System_Ext(catalog, "Музыкальный каталог", "Предоставляет сведения о треках и исполнителях")
System_Ext(similar, "Сервис рекомендаций похожих пользователей", "Предоставляет кандидатов на основе сходства музыкальных предпочтений")
System_Ext(editorial, "Редакционные подборки", "Предоставляют отобранные редакцией треки")

Rel(user, app, "Слушает плейлист, ставит лайки и пропускает треки")
Rel(app, playlist, "Запрашивает плейлист и передаёт события прослушивания")
Rel(playlist, app, "Публикует сформированный семейный плейлист")
Rel(playlist, family, "Получает состав семьи и настройки участия")
Rel(playlist, history, "Получает историю прослушиваний активных участников")
Rel(playlist, catalog, "Получает метаданные треков")
Rel(playlist, similar, "Получает рекомендации и кандидатов")
Rel(playlist, editorial, "Получает редакционные подборки")

@enduml
